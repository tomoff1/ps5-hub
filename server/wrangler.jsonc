{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ps5-hub-catalog",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "HUB",
			"id": "8cfc859266154905842d66beff594cb5"
		}
	],
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	},
	"observability": {
		"enabled": false
	}
}